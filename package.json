{
  "name": "maya-agent-sandbox",
  "version": "0.2.0",
  "description": "MAYA: GitLab Duo workforce for CI/CD source repair, verified staging and reviewed company memory.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "bin": {
    "maya": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    ".gitlab/duo"
  ],
  "scripts": {
    "dev": "tsx watch src/server/cli.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/cli.js",
    "prepack": "npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write src test e2e integration *.ts *.json",
    "format:check": "prettier --check src test e2e integration *.ts *.json",
    "test:connected": "playwright test --config=playwright.connected.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "diff": "^8.0.4",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
